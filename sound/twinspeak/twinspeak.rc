// twinspeak.rc -- v6.6.4: app icon + version info. v7.5.3..v7.7.9: version
// bumps (the full per-version notes live in CHANGELOG.txt).
// v7.8.0: THE ONE-FILE WINDOW HEADER RETIRES, WHOLE -- no include, no stub
// file, no external chrome API. The window is the flat default Windows 10
// frame (a stock WS_OVERLAPPEDWINDOW: native caption, icon, title, min/max/
// close, sysmenu, resize, shadow), and every dark theme re-dials
// DWMWA_USE_IMMERSIVE_DARK_MODE from the theme's background lightness so
// the native titlebar follows the app's dark/light themes (attribute 20
// with the 19 fallback, re-applied on every applyTheme and at creation).
// The DPI child ledger lives in twinspeak.cpp now. Version steps to 7.8.0.
// (the historical v7.5.x..v7.7.x window work -- the one-file window
// header's arrival and every uDWM byte-chase it bought -- is retired with
// it; the notes are preserved in CHANGELOG.txt)
// No windows.h include needed -- the VERSIONINFO and
// RT_MANIFEST forms used here are RC syntax, not C macros, so both windres
// and zig rc accept this file as-is.
// v7.1.20: `1 24` embeds twinspeak.manifest (RT_MANIFEST = 24, id 1) --
// DPI awareness (the blur fix), comctl32 v6 (DarkMode_Explorer), asInvoker.
// v7.1.21: the manifest's XML comments lost their "--" (illegal inside XML
// comments -- the SxS loader refused the whole file and the exe would not
// start: "side-by-side configuration is incorrect").
1 ICON "twinspeak.ico"
1 24 "twinspeak.manifest"

1 VERSIONINFO
FILEVERSION     7,8,0,0
PRODUCTVERSION  7,8,0,0
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TidyVision"
            VALUE "FileDescription",  "TwinSpeak Control Panel"
            VALUE "FileVersion",      "7.8.0.0"
            VALUE "InternalName",     "twinspeak"
            VALUE "LegalCopyright",   "Copyright 2026-beyond TidyVision -- MIT License"
            VALUE "OriginalFilename", "twinspeak.exe"
            VALUE "ProductName",      "TidyVision TwinSpeak"
            VALUE "ProductVersion",   "7.8.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
