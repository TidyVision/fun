// twinspeak.rc -- resources for the panel binary (v6.5.5 lineage).
// No windows.h include: raw numeric constants only, so windres / zig rc both
// compile it standalone. VERSIONINFO gives Task Manager its "TwinSpeak"
// name; the icon is the tray/window icon; RT_MANIFEST (24) id 1 embeds
// twinspeak.manifest (comctl32 v6 + PerMonitorV2 + asInvoker).

1 ICON "twinspeak.ico"
1 24 "twinspeak.manifest"

1 VERSIONINFO
FILEVERSION     8,4,4,0
PRODUCTVERSION  8,4,4,0
FILEOS          0x00040004L          // VOS_NT_WINDOWS32
FILETYPE        0x1L                 // VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"                 // US English, Unicode
    BEGIN
      VALUE "FileDescription",   "TwinSpeak"
      VALUE "ProductName",       "TwinSpeak"
      VALUE "FileVersion",       "8.4.4.0"
      VALUE "ProductVersion",    "8.4.4.0"
      VALUE "OriginalFilename",  "twinspeak.exe"
      VALUE "InternalName",      "twinspeak"
      VALUE "Comments",          "TidyVision TwinSpeak -- bit-exact ASIO-strict engine"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
