// twinspeak.rc -- v6.6.4: app icon + version info. v7.2.5: version bump
// (the owned row). v7.2.4: version bump
// (the opaque hold). v7.2.3: version bump
// (the NC-flip present). v7.2.2: version bump
// + the name split: FileDescription stays the PROCESS name Task Manager
// reads ("TwinSpeak Control Panel"); ProductName takes the brand
// ("TidyVision TwinSpeak") -- the same split the windows carry (the taskbar
// window is "TidyVision TwinSpeak", the hidden tray surrogate is "TwinSpeak
// Control Panel").
// (v7.1.21: the manifest; v7.1.22..v7.2.0: window-side fixes only).
// No windows.h include needed -- the VERSIONINFO and
// RT_MANIFEST forms used here are RC syntax, not C macros, so both windres
// and zig rc accept this file as-is.
// v7.1.20: `1 24` embeds twinspeak.manifest (RT_MANIFEST = 24, id 1) --
// DPI awareness (the blur fix), comctl32 v6 (DarkMode_Explorer), asInvoker.
// v7.1.21: the manifest's XML comments lost their "--" (illegal inside XML
// comments -- the SxS loader refused the whole file and the exe would not
// start: "side-by-side configuration is incorrect").
1 ICON "twinspeak.ico"
1 24 "twinspeak.manifest"

1 VERSIONINFO
FILEVERSION     7,2,5,0
PRODUCTVERSION  7,2,5,0
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TidyVision"
            VALUE "FileDescription",  "TwinSpeak Control Panel"
            VALUE "FileVersion",      "7.2.5.0"
            VALUE "InternalName",     "twinspeak"
            VALUE "LegalCopyright",   "Copyright 2026-beyond TidyVision -- MIT License"
            VALUE "OriginalFilename", "twinspeak.exe"
            VALUE "ProductName",      "TidyVision TwinSpeak"
            VALUE "ProductVersion",   "7.2.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
